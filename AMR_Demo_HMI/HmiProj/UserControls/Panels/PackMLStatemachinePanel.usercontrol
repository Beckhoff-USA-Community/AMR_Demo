  {
    "event": "%pp%data::CurrentState%/pp%",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%pmlpanel-ddt-state::Value%/ctrl%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%f%TcHmi.Functions.TcHmiExtendedControls.EnumToString(%pp%data::CurrentState%/pp%).replace('ePMLState_', '')%/f%"
