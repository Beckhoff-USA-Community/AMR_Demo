<div id="system-btn-refresh" data-tchmi-type="TcHmi.Controls.TcHmiExtendedControls.ConfirmationButton" data-tchmi-left="20" data-tchmi-left-unit="px" data-tchmi-text="Refresh Browser" data-tchmi-top="20" data-tchmi-top-unit="px" data-tchmi-word-wrap="true" data-tchmi-right="20" data-tchmi-bottom="20" data-tchmi-confirmation-message="Are you sure you would like to refresh the browser?">



<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onConfirmed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "location.reload()"
        ],
        "asyncWait": true,
        "injectContextObject": false,
        "waitMode": "Synchronous"
      }
    ]
  }
]</script>
</div>
<div id="settings-btn-close" data-tchmi-type="TcHmi.Controls.TcHmiExtendedControls.ConfirmationButton" data-tchmi-grid-column-index="1" data-tchmi-grid-row-index="0" data-tchmi-left="20" data-tchmi-left-unit="px" data-tchmi-text="Close HMI" data-tchmi-top="20" data-tchmi-top-unit="px" data-tchmi-word-wrap="true" data-tchmi-right="20" data-tchmi-bottom="20" data-tchmi-confirmation-message="Are you sure you would like to close the HMI?">



<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onConfirmed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "window.close()"
        ],
        "asyncWait": true,
        "injectContextObject": false,
        "waitMode": "Synchronous"
      }
    ]
  }
]</script>
</div>
<div id="settings-btn-restartserver" data-tchmi-type="TcHmi.Controls.TcHmiExtendedControls.ConfirmationButton" data-tchmi-grid-column-index="2" data-tchmi-grid-row-index="0" data-tchmi-left="20" data-tchmi-left-unit="px" data-tchmi-text="Restart HMI Server" data-tchmi-top="20" data-tchmi-top-unit="px" data-tchmi-word-wrap="true" data-tchmi-right="20" data-tchmi-bottom="20" data-tchmi-confirmation-message="Are you sure you would like to restart the HMI Server?">



<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onConfirmed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%Restart%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/String",
          "value": null
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": false,
        "sourceLines": [
          "// Request object.",
          "/** @type {TcHmi.Server.IMessage} */",
          "var request = {",
          "    \"commands\": [",
          "        {",
          "            \"commandOptions\": [",
          "                \"SendErrorMessage\",",
          "                \"SendWriteValue\"",
          "            ],",
          "            \"symbol\": \"Restart\"",
          "        }",
          "    ],",
          "    \"requestType\": \"ReadWrite\"",
          "};",
          "",
          "// Send request to TwinCAT HMI Server.",
          "TcHmi.Server.requestEx(request, { timeout: 2000 }, function(data){",
          "    // Callback handling.",
          "    if(data.error !== TcHmi.Errors.NONE){",
          "        // Handle TcHmi.Server class level error here.",
          "        console.log(data.error)",
          "        return;",
          "    }",
          "    var response = data.response;",
          "    if (!response || response.error !== undefined) {",
          "        // Handle TwinCAT HMI Server response level error here.",
          "        console.log(response)",
          "        return;",
          "    }",
          "    var commands = response.commands;",
          "    if(commands === undefined){",
          "        console.log(commands)",
          "        return;",
          "    }",
          "    for(var i = 0, ii = commands.length; i < ii; i++){",
          "        var command = commands[i];",
          "        if(command === undefined){",
          "        \tconsole.log(command)",
          "            return;",
          "        }",
          "        if(command.error !== undefined){",
          "            // Handle TwinCAT HMI Server command level error here.",
          "        \tconsole.log(command.error)",
          "            return;",
          "        }",
          "        // Handle result...",
          "        console.log(command)",
          "        TcHmi.Log.debugEx(command.symbol, ':', command.readValue);",
          "    }",
          "});"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]</script>
</div>
<div id="settings-btn-centermachinecontrol" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-grid-column-index="3" data-tchmi-grid-row-index="0" data-tchmi-height-unit="px" data-tchmi-left="20" data-tchmi-left-unit="px" data-tchmi-text="Center Machine Control Flyout" data-tchmi-top="20" data-tchmi-top-unit="px" data-tchmi-width-unit="px" data-tchmi-word-wrap="True" data-tchmi-right="20" data-tchmi-bottom="20">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%desktop-grid-machinecontrol::Top%/ctrl%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:framework#/definitions/MeasurementValue",
          "symbolExpression": "%f%%ctrl%Desktop::RenderedHeight%/ctrl%/2-%ctrl%desktop-grid-machinecontrol::RenderedHeight%/ctrl%/2%/f%"
        },
        "asyncWait": true
      }
    ]
  }
]</script>
